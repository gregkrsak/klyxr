type Percent = range 0..100;

record Battery {
    charge: Percent
}

verified fn consume(battery: &mut Battery, amount: Percent)
    requires amount <= battery.charge
    ensures battery.charge == old(battery.charge) - amount
{
    battery.charge -= amount;
}

let mut battery = Battery { charge: 80 };
consume(&mut battery, 50);
// The first call leaves 30. The second call must fail.
consume(&mut battery, 50);
