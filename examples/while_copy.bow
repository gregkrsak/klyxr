// Frontend/MIR example only: no execution or termination proof.
type Percent = range 0..100;
fn update(flag: bool, value: Percent, replacement: Percent) -> Percent {
    let mut current = value;
    let mut running = flag;
    while running {
        current = replacement;
        current = current;
        running = false;
    }
    return current;
}
